#!/sbin/sh

SKIPUNZIP=1

# ── Extract module files ─────────────────────────────────────
unzip -o "$ZIPFILE" 'module.prop'       -d "$MODPATH" >&2
unzip -o "$ZIPFILE" 'system.prop'       -d "$MODPATH" >&2
unzip -o "$ZIPFILE" 'service.sh'        -d "$MODPATH" >&2
unzip -o "$ZIPFILE" 'post-fs-data.sh'   -d "$MODPATH" >&2
unzip -o "$ZIPFILE" 'customize.sh'      -d "$MODPATH" >&2
unzip -o "$ZIPFILE" 'zygisk/*'          -d "$MODPATH" >&2
unzip -o "$ZIPFILE" 'system/*'          -d "$MODPATH" >&2 2>/dev/null || true

chmod 0755 "$MODPATH/service.sh"
chmod 0755 "$MODPATH/post-fs-data.sh"
chmod 0755 "$MODPATH/customize.sh"

# ── Source customize.sh (handles Magisk module API install UI) ─
. "$MODPATH/customize.sh"
