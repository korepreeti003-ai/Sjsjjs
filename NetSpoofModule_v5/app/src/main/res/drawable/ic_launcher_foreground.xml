<?xml version="1.0" encoding="utf-8"?>
<!-- NetSpoof launcher icon: signal tower over a shield -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Shield body -->
    <path
        android:pathData="M54,20 L80,32 L80,56 C80,70 68,80 54,86 C40,80 28,70 28,56 L28,32 Z"
        android:fillColor="#7B61FF"/>

    <!-- Shield inner highlight -->
    <path
        android:pathData="M54,28 L74,38 L74,56 C74,67 64,75 54,80 C44,75 34,67 34,56 L34,38 Z"
        android:fillColor="#0D0D1A"/>

    <!-- Signal waves (outer) -->
    <path
        android:pathData="M42,50 Q38,44 42,38"
        android:strokeColor="#00E5FF"
        android:strokeWidth="3"
        android:fillColor="@android:color/transparent"
        android:strokeLineCap="round"/>
    <path
        android:pathData="M66,50 Q70,44 66,38"
        android:strokeColor="#00E5FF"
        android:strokeWidth="3"
        android:fillColor="@android:color/transparent"
        android:strokeLineCap="round"/>

    <!-- Signal waves (inner) -->
    <path
        android:pathData="M46,50 Q43,44 46,40"
        android:strokeColor="#00E5FF"
        android:strokeWidth="2.5"
        android:fillColor="@android:color/transparent"
        android:strokeLineCap="round"/>
    <path
        android:pathData="M62,50 Q65,44 62,40"
        android:strokeColor="#00E5FF"
        android:strokeWidth="2.5"
        android:fillColor="@android:color/transparent"
        android:strokeLineCap="round"/>

    <!-- Center dot -->
    <circle
        android:centerX="54"
        android:centerY="44"
        android:radius="4"
        android:fillColor="#00E5FF"/>

    <!-- Antenna mast -->
    <path
        android:pathData="M54,44 L54,62"
        android:strokeColor="#00E5FF"
        android:strokeWidth="2.5"
        android:strokeLineCap="round"/>

    <!-- Antenna base -->
    <path
        android:pathData="M48,62 L60,62"
        android:strokeColor="#7B61FF"
        android:strokeWidth="2.5"
        android:strokeLineCap="round"/>
</vector>
